+            for row in cert.rows
+                r=mapped(row);ci=optimizer_index(r);ri=MosekTools.row(native,ci);nn,cols,vals=MSK.getarow(task,ri)
+                bk,lo,up=MSK.getconbound(task,ri);o=constraint_object(r);a,c=coefficients(o.func,col)
